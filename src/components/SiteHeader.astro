---
import { nav, paths, t, LOCALES } from '../data/i18n';
import type { Locale } from '../data/i18n';

interface Props {
  locale: Locale;
  pageKey: keyof typeof paths;
}

const { locale, pageKey } = Astro.props;
const home = paths.home[locale];
const servicesHash = pageKey === 'home' ? '#hizmetler' : home + '#hizmetler';
const showcasePath = paths.ornekler[locale];
const whyPath = paths.neden[locale];
const faqPath = paths.sss[locale];
const contactHash = pageKey === 'home' ? '#iletisim' : home + '#iletisim';
const localeLabels: Record<Locale, string> = { tr: 'TR', en: 'EN', ar: 'AR' };
---
<header class="top">
  <div class="wrap">
    <a class="logo" href={home} aria-label="Livesider">L<span class="i">ı<span class="dot" aria-hidden="true"></span></span>vesider</a>
    <nav class="links" aria-label="Menu">
      <a class="navtxt" href={servicesHash}>{t(nav.services, locale)}</a>
      <a class="navtxt" href={showcasePath} aria-current={pageKey === 'ornekler' ? 'page' : undefined}>{t(nav.showcase, locale)}</a>
      <a class="navtxt" href={whyPath} aria-current={pageKey === 'neden' ? 'page' : undefined}>{t(nav.why, locale)}</a>
      <a class="navtxt" href={faqPath} aria-current={pageKey === 'sss' ? 'page' : undefined}>{t(nav.faq, locale)}</a>
      <a class="navtxt" href={contactHash}>{t(nav.contact, locale)}</a>
      <div class="lang" role="group" aria-label="Dil / Language / اللغة">
        {LOCALES.map((loc) => (
          <a href={paths[pageKey][loc]} hreflang={loc} aria-current={locale === loc ? 'page' : undefined} lang={loc}>{localeLabels[loc]}</a>
        ))}
      </div>
    </nav>
  </div>
</header>
