---
import Base from '../../layouts/Base.astro';
import MailBlock from '../../components/MailBlock.astro';
import { meta, siteUrl, t } from '../../data/i18n';
import '../../styles/sss.css';

const locale = 'ar' as const;
const page = meta.sss;

const faqs = [
  {
    q: 'يوجد ملايين العلامات على إنستغرام أصلًا. من سيجدني في مكان جديد؟',
    a: [
      'سؤال خاطئ. على قناتك الخاصة لست <strong>تحاول اصطياد غرباء</strong>؛ بل تحوّل الناس الذين وصل إليهم صوتك على التواصل الاجتماعي إلى مشاهدين مباشرين.',
      'التواصل الاجتماعي طبقة "اجعل نفسك مرئيًا" — مزدحمة، ضاجّة، مكلفة. أما قناتك فطبقة "ابنِ العلاقة وأغلق البيع" — هادئة، مركّزة، مربحة.',
      'إذًا لا تترك إنستغرام. تستخدم إنستغرام <em>واجهة تغذّي قناتك الخاصة</em>.',
    ],
  },
  {
    q: 'ما البث المغلق، وما الفرق بينه وبين البث العام؟',
    a: [
      'البث العام = YouTube Live أو Instagram Live. يراه الجميع، وتقرر الخوارزمية من يرى ماذا ومتى، ويمكن أن يُعرض إعلان منافس أو ترند عشوائي بجانب علامتك.',
      'البث المغلق = غرفة بث يدخلها فقط المدعوون أو الأعضاء أو شرائح محددة. قواعدك، شاشتك، توزيعك.',
      'حالات الاستخدام:',
      '<ul><li>معاينات VIP للإطلاقات للعملاء الحاليين</li><li>تدريب الموزعين والوكلاء</li><li>محتوى مميّز للأعضاء فقط</li><li>مزادات أو معارض بالدعوة فقط</li><li>جلسات عرض B2B مباشرة</li></ul>',
    ],
  },
  {
    q: 'ما الضرر الذي يسببه المشاهد غير المناسب لعلامتي حقًا؟',
    a: [
      'في البث العام تبدو كل نقرة ذات قيمة. لكن <strong>المشاهد الخاطئ ضجيج</strong> للعلامة، وأحيانًا ضرر.',
      'تتضخم أعداد المشاهدات بينما تنخفض معدلات التحويل. ثم تستخدم منصات الإعلانات هذه الإشارة لإرسال "مشاهدين خاطئين" أكثر — دائرة مغلقة تطعم نفسها.',
      'المهم هو <em>الـ 500 شخص المناسبون</em>، لا 50,000 ظهور عرضي. البث المغلق يقوم بهذا الاختيار عند الباب.',
    ],
  },
  {
    q: 'كيف يُمنح العميل فعلًا شعور الـ VIP؟',
    a: [
      'شعور الـ VIP هو مجموع:',
      '<ul><li><strong>امتياز الوصول:</strong> بث لا يراه إلا الأعضاء.</li><li><strong>امتياز الوقت:</strong> رؤية المنتج قبل 48 ساعة من طرحه للبيع.</li><li><strong>امتياز الحوار:</strong> سؤال وجواب مباشر مع المقدّم، وذكر الاسم.</li><li><strong>امتياز المكان:</strong> استوديو العلامة وواجهتها — ليس منطقة ترويج لشيء آخر.</li></ul>',
      'لا يمكن تقديم أي من هذه الامتيازات الأربعة على Instagram Live؛ وجميعها طبيعية على قناتك الخاصة.',
    ],
  },
  {
    q: 'لماذا تتآكل قيمة علامتي على وسائل التواصل الاجتماعي؟',
    a: [
      'لأن ما يتحدث على التواصل الاجتماعي ليس <strong>العلامة نفسها</strong>، بل <strong>قوانين التدفق</strong>: اصطد الانتباه في 15 ثانية، لاحق الترندات، ارقص.',
      'علامة مجوهرات فاخرة تمرّ بجانب حساب ميمات. مطعم بوتيكي يظهر في التدفق نفسه مع إعلان دروبشيبينغ رخيص. إدراك السعر يتأذى من هذه الجيرة.',
      'في قناتك الخاصة لا يوجد بجانب علامتك سوى برامج أخرى — كلها من إنتاج العلامة، بالجمالية نفسها والانضباط نفسه.',
    ],
  },
  {
    q: 'أليس بناء عالمي الرقمي الخاص عبئًا كبيرًا؟',
    a: [
      'الإعداد الأولي، نعم، استثمار. بعد ذلك يمكن لفريق صغير إدارته.',
      'يكفي <strong>بث مباشر واحد في الأسبوع مع ساعات قليلة من التخطيط</strong>. يُنتج هذا البث 10-15 مقطعًا قصيرًا يُغذّي التواصل الاجتماعي أسبوعًا كاملًا. إذًا حجم العمل لا يزداد؛ <em>الجهد المتكرر يتركز في عرض واحد قوي</em>.',
      'نحن نُنشئ الاستوديو والبنية التحتية وجدول البث؛ ونُدرّب فريقك؛ ومن هناك يستمر التشغيل معك.',
    ],
  },
  {
    q: 'هل عليّ أن أترك وسائل التواصل الاجتماعي تمامًا؟',
    a: [
      'لا. الهندسة الفعلية هي:',
      '<ul><li><strong>التواصل الاجتماعي</strong> → فم القمع. حيث يكتشفك الناس.</li><li><strong>القناة الخاصة</strong> → قاع القمع. حيث يتحول المشاهد إلى عميل.</li></ul>',
      'من دون التواصل الاجتماعي تتقلّص الحركة الواردة. من دون قناة خاصة، تحويل تلك الحركة إلى مبيعات يبقى في كل مرة رهينة رحمة المنصة.',
    ],
  },
  {
    q: 'كيف أقيس عائد هذا الاستثمار؟',
    a: [
      'على قناتك الخاصة <strong>كل مقياس لك</strong>. كل نقطة بيانات لا يعطيها إنستغرام أبعد من "المشاهدات" تأتي بشكل طبيعي:',
      '<ul><li>عدد الأعضاء ومعدل النمو</li><li>وقت المشاهدة لكل بث</li><li>النقرات داخل البث والإضافة إلى السلة</li><li>القيمة الدائمة لكل عضو</li><li>معدل إعادة المشاهدة</li><li>حركة المقاطع بعد البث</li></ul>',
      'بهذه البيانات تصبح خطة محتواك وإنفاقك الإعلاني أكثر دقة كل شهر.',
    ],
  },
  {
    q: 'لمن لا يناسب هذا العمل؟',
    a: [
      'القناة تحتاج إلى <em>إنتاج منتظم ووجهة نظر</em>. العلامات التي لا تستطيع تخصيص حتى 15 دقيقة أسبوعية في الاستوديو، أو ليس لديها قصة تحكيها، أو تجد صعوبة في التحدث مباشرة مع عملائها — ليست مناسبة لها.',
      'في المقابل: أي علامة — صغيرة أو كبيرة — تريد أن تشرح منتجها، أو تشارك خبرتها، أو تبني مجتمع عملاء، ستجد أن القناة الخاصة منطقية.',
    ],
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': siteUrl + '/ar/faq#faq',
  inLanguage: 'ar-SA',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a.join(' ').replace(/<[^>]+>/g, ''),
    },
  })),
};
---
<Base locale={locale} pageKey="sss" title={t(page.title, locale)} description={t(page.description, locale)} jsonLd={faqJsonLd}>
  <main>
    <section class="hero faq">
      <div class="wrap">
        <div>
          <span class="eyebrow">أسئلة وأجوبة</span>
          <span class="motto">ابنِ عالم علامتك الرقمي الخاص</span>
          <h1>ليس حسابًا في زحام الملايين. <em>بل علامة في عالمها الخاص.</em></h1>
        </div>
        <div class="side">
          <p>بينما تحاول أن تُلاحظ بين ملايين الحسابات على إنستغرام، تبتعد كل يوم قليلًا عن عملائك الحقيقيين وجمهورك المحتمل. البث المغلق يُبعد المشاهد غير المناسب، ويحمي قيمة العلامة، ويقول لكل عميل: "أنت المدعوّ".</p>
          <div class="quote">قيمة العلامة تُقاس بمن تتحدث معهم، لا بمن تظهر لهم.</div>
        </div>
      </div>
    </section>

    <section class="thesis">
      <div class="wrap">
        <h2>الأطروحة.</h2>
        <div class="body">
          <p>وسائل التواصل الاجتماعي <em>تُعلن</em> عن علامتك. أما عالمك الرقمي الخاص فـ <em>يُحييها</em>. الاختيار ليس بين الاثنين، بل في توزيع الأدوار بينهما بشكل صحيح.</p>
          <p>إنستغرام وتيك توك ويوتيوب — كلها شقق تعيش فيها علامتك مستأجرة. إدارة العمارة تضع القواعد، لا يمكنك اختيار جيرانك، ولا تعرف من سيطرق بابك. أما قناتك الخاصة فهي عمارتك: البواب، وقواعد الدخول، وقائمة المدعوين — كلها بيدك.</p>
          <p>تجمع هذه الصفحة الأجوبة العملية على سؤال "لماذا أبني عالمي الرقمي الخاص؟".</p>
        </div>
      </div>
    </section>

    <section class="qa-block">
      <div class="wrap">
        <div class="sec-head">
          <h2>الأسئلة الأكثر طرحًا</h2>
          <p>الأسئلة التسعة التي يطرحها معظم أصحاب العلامات عندما يفكرون في هذا، والأجوبة التي نقدمها. اضغط للفتح.</p>
        </div>
        <div class="qa-list">
          {faqs.map((f, i) => (
            <details class="qa-item">
              <summary>
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <span class="q">{f.q}</span>
                <span class="toggle" aria-hidden="true"></span>
              </summary>
              <div class="answer">
                <div>
                  {f.a.map((p) => (
                    <p set:html={p} />
                  ))}
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="cta faq-cta" id="iletisim">
      <div class="wrap">
        <span class="eyebrow">البقية في حوار</span>
        <h2>لنتحدث كيف نبني عالمك الرقمي الخاص.</h2>
        <p>أخبرنا عن علامتك وجمهورك المستهدف ووجودك الرقمي الحالي؛ سنرسم خارطة طريق مُخصّصة لك.</p>
        <MailBlock locale={locale} />
      </div>
    </section>
  </main>
</Base>
