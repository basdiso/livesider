---
import '../styles/global.css';
import Head from '../components/Head.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { paths } from '../data/i18n';
import type { Locale } from '../data/i18n';

interface Props {
  locale: Locale;
  pageKey: keyof typeof paths;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  bodyClass?: string;
}

const { locale, pageKey, title, description, jsonLd, bodyClass } = Astro.props;
---
<!doctype html>
<html lang={locale}>
  <head>
    <Head locale={locale} pageKey={pageKey} title={title} description={description} jsonLd={jsonLd} />
    <slot name="head-extra" />
  </head>
  <body class={bodyClass}>
    <SiteHeader locale={locale} pageKey={pageKey} />
    <slot />
    <SiteFooter locale={locale} />
    <script>
      import '../scripts/copy-mail';
    </script>
  </body>
</html>
